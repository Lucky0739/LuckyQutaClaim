    </select>

    <select id="selectAllBanners" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_banner
        WHERE is_delete = 0 AND status = 1
        ORDER BY sort ASC
    </select>

    <update id="deleteByPrimaryKey" parameterType="java.lang.Long">
