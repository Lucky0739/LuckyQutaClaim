<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--suppress ALL -->
<mapper namespace="com.lucky.quota.goods.mapper.GoodsCollectMapper">

    <resultMap id="BaseResultMap" type="com.lucky.quota.goods.model.entity.GoodsCollect">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="user_id" property="userId" jdbcType="BIGINT"/>
        <result column="goods_id" property="goodsId" jdbcType="BIGINT"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <resultMap id="GoodsCollectVOResultMap" type="com.lucky.quota.goods.model.vo.GoodsCollectVO">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="goods_id" property="goodsId" jdbcType="BIGINT"/>
        <result column="goods_name" property="goodsName" jdbcType="VARCHAR"/>
        <result column="goods_img" property="goodsImg" jdbcType="VARCHAR"/>
        <result column="goods_price" property="goodsPrice" jdbcType="DECIMAL"/>
        <result column="collect_num" property="collectNum" jdbcType="INTEGER"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <insert id="insertSelective" parameterType="com.lucky.quota.goods.model.entity.GoodsCollect"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_user_goods_collect
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="goodsId != null">goods_id,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId,jdbcType=BIGINT},</if>
            <if test="goodsId != null">#{goodsId,jdbcType=BIGINT},</if>
            <if test="createTime != null">#{createTime,jdbcType=TIMESTAMP},</if>
        </trim>
    </insert>

    <select id="selectByUserIdAndGoodsId" resultMap="BaseResultMap">
        SELECT id, user_id, goods_id, create_time
        FROM t_user_goods_collect
        WHERE user_id = #{userId,jdbcType=BIGINT}
          AND goods_id = #{goodsId,jdbcType=BIGINT}
        LIMIT 1
    </select>

    <delete id="deleteByUserIdAndGoodsId">
        DELETE FROM t_user_goods_collect
        WHERE user_id = #{userId,jdbcType=BIGINT}
          AND goods_id = #{goodsId,jdbcType=BIGINT}
    </delete>

    <select id="selectCollectVOListByUserId" resultMap="GoodsCollectVOResultMap">
        SELECT
            c.id,
            c.goods_id,
            g.goods_name,
            g.goods_img,
            g.goods_price,
            g.collect_num,
            c.create_time
        FROM t_user_goods_collect c
        INNER JOIN t_goods g ON c.goods_id = g.id AND g.isDelete = 0
        WHERE c.user_id = #{userId,jdbcType=BIGINT}
        ORDER BY c.create_time DESC
    </select>
</mapper>
